"""Verifikasi pendamping Python; BUKAN hasil menjalankan skrip R.
Split Park-Miller dan fold mengikuti skrip unggahan. OLS memakai desain
F sebagai acuan; implementasi pohon/RF scikit-learn tidak identik dengan R.
Jalankan dari folder proyek: python 04_Verifikasi_Python.py
"""
from pathlib import Path
import json, hashlib, platform, sys
import numpy as np
import pandas as pd
import scipy
from scipy import stats
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor
from sklearn.ensemble import RandomForestRegressor
from sklearn.tree import DecisionTreeRegressor
import sklearn

ROOT = Path(__file__).resolve().parent
OUT = ROOT / 'hasil_python'
OUT.mkdir(exist_ok=True)
d = pd.read_csv(ROOT/'data/abalone.csv')
cols = ['Sex','Length','Diameter','Height','Whole_weight','Shucked_weight','Viscera_weight','Shell_weight','Rings']
assert d.columns.tolist()==cols and not d.isna().any().any()
assert set(d.Sex)=={'F','I','M'}
y = d.Rings.to_numpy(dtype=float)
# Same reference category as factor(levels=c('F','I','M')) in R.
X = pd.DataFrame({'SexI': (d.Sex=='I').astype(float), 'SexM': (d.Sex=='M').astype(float)})
for c in cols[1:-1]: X[c] = d[c].astype(float)
Z = sm.add_constant(X)
Xs = sm.add_constant(d[['Shell_weight']])
ols = sm.OLS(y, Xs).fit()
full = sm.OLS(y, Z).fit()
hc3 = ols.get_robustcov_results(cov_type='HC3', use_t=True)
hc3full = full.get_robustcov_results(cov_type='HC3', use_t=True)

def coef_table(model, names):
    ci = np.asarray(model.conf_int())
    return pd.DataFrame({'Variabel':names, 'Koefisien':np.asarray(model.params), 'SE_HC3':np.asarray(model.bse), 'p_HC3':np.asarray(model.pvalues),'CI95_bawah':ci[:,0], 'CI95_atas':ci[:,1]})
coef_table(hc3,Xs.columns).to_csv(OUT/'inferensi_sederhana_HC3.csv',index=False)
coef_table(hc3full,Z.columns).to_csv(OUT/'inferensi_berganda_HC3.csv',index=False)
vif = pd.DataFrame({'Kolom_desain':X.columns,'VIF':[variance_inflation_factor(Z.to_numpy(),i+1) for i in range(X.shape[1])]})
vif.to_csv(OUT/'vif_kolom_desain.csv',index=False)
flag=(d.Height<=0)|(d.Height>0.3)
audit=d.loc[flag].copy(); audit.insert(0,'baris_asli',np.flatnonzero(flag)+1)
audit.to_csv(OUT/'audit_height.csv',index=False)
sens=sm.OLS(y[~flag],Z.loc[~flag]).fit()
infl=full.get_influence()
cook=infl.cooks_distance[0]
infrows=np.argsort(cook)[-5:][::-1]
pd.DataFrame({'baris_asli':infrows+1,'Cooks_D':cook[infrows],'leverage':infl.hat_matrix_diag[infrows]}).to_csv(OUT/'influential.csv',index=False)
x=d.Shell_weight.to_numpy()
manual = {'n':len(y),'sum_x':x.sum(),'sum_y':y.sum(),'sum_x2':(x*x).sum(),'sum_xy':(x*y).sum(),'mean_x':x.mean(),'mean_y':y.mean(),'Sxx':((x-x.mean())**2).sum(),'Sxy':((x-x.mean())*(y-y.mean())).sum(),'b0':ols.params.iloc[0],'b1':ols.params.iloc[1],'SSE':(ols.resid**2).sum(),'SST':((y-y.mean())**2).sum(),'R2':ols.rsquared,'SE_b1_OLS':ols.bse.iloc[1],'t_b1_OLS':ols.tvalues.iloc[1],'SE_b1_HC3':hc3.bse[1],'CI_HC3_low':hc3.conf_int()[1,0],'CI_HC3_high':hc3.conf_int()[1,1],'x_example':0.25,'prediction_example':float(ols.predict([1,0.25])[0])}
pd.DataFrame(manual.items(),columns=['Statistik','Nilai']).to_csv(OUT/'perhitungan_manual.csv',index=False)
# IDENTICAL split/fold definition to the uploaded R script (1-based IDs exported).
state=2026; scores=[]
for _ in range(len(d)):
    state=(48271*state)%2147483647
    scores.append(state)
order=np.argsort(scores)
ntrain=int(np.floor(0.8*len(d)))
tr=order[:ntrain]; te=order[ntrain:]
fold=np.arange(ntrain)%5+1
split=pd.DataFrame({'baris_asli':np.arange(1,len(d)+1),'bagian':'uji','fold':0})
split.loc[tr,'bagian']='latih'; split.loc[tr,'fold']=fold
split.to_csv(OUT/'split_dan_fold.csv',index=False)
names=['Rata-rata','Regresi sederhana','Regresi berganda','Pohon regresi','Random Forest']

def metric(a,p):
    e=np.asarray(a)-np.asarray(p)
    return {'MAE':float(np.mean(abs(e))),'RMSE':float(np.sqrt(np.mean(e*e))),'R2':float(1-np.sum(e*e)/np.sum((a-np.mean(a))**2))}

def fit_and_predict(ids, val, seed, keep=False):
    simple=sm.OLS(y[ids],Xs.iloc[ids]).fit()
    multi=sm.OLS(y[ids],Z.iloc[ids]).fit()
    # This is an accompanying Python implementation, NOT an rpart replication.
    tree=DecisionTreeRegressor(min_samples_leaf=15,random_state=seed)
    tree.fit(X.iloc[ids],y[ids])
    rf=RandomForestRegressor(n_estimators=300,max_features=3,min_samples_leaf=1,random_state=seed,n_jobs=2)
    rf.fit(X.iloc[ids],y[ids])
    p=[np.repeat(y[ids].mean(),len(val)),simple.predict(Xs.iloc[val]).to_numpy(),multi.predict(Z.iloc[val]).to_numpy(),tree.predict(X.iloc[val]),rf.predict(X.iloc[val])]
    return dict(zip(names,p)),(simple,multi,tree,rf)

cv={n:np.zeros(ntrain) for n in names}
fold_metrics=[]
for k in range(1,6):
    print('CV fold',k,flush=True)
    trainid=tr[fold!=k]; valid=tr[fold==k]
    ps,_=fit_and_predict(trainid,valid,2026+k)
    for n in names:
        cv[n][fold==k]=ps[n]
        fold_metrics.append({'Model':n,'Fold':k,**metric(y[valid],ps[n])})
pred,models=fit_and_predict(tr,te,3030,True)
res=[]
for name in names:
    res.append({'Model':name,**{'CV_'+k:v for k,v in metric(y[tr],cv[name]).items()},**{'Uji_'+k:v for k,v in metric(y[te],pred[name]).items()}})
res=pd.DataFrame(res).sort_values('CV_RMSE').reset_index(drop=True)
res.to_csv(OUT/'perbandingan_model_PYTHON.csv',index=False)
pd.DataFrame(fold_metrics).to_csv(OUT/'skor_per_fold.csv',index=False)
pd.DataFrame({'baris_asli':te+1,'Rings':y[te],**pred}).to_csv(OUT/'prediksi_uji.csv',index=False)
pd.DataFrame({'baris_asli':tr+1,'fold':fold,'Rings':y[tr],**cv}).to_csv(OUT/'prediksi_oof.csv',index=False)
# Conditional paired bootstrap: no model refit, no re-selection.
rng=np.random.default_rng(5050)
B=2000
boot={n:[] for n in names}; diffs=[]
for b in range(B):
    ids=rng.integers(0,len(te),len(te))
    for n in names: boot[n].append(metric(y[te][ids],pred[n][ids])['RMSE'])
    diffs.append(boot['Random Forest'][-1]-boot['Regresi berganda'][-1])
bootrows=[]
for n in names:
    lo,hi=np.quantile(boot[n],[.025,.975])
    bootrows.append({'Model':n,'RMSE':metric(y[te],pred[n])['RMSE'],'CI95_bawah':lo,'CI95_atas':hi})
pd.DataFrame(bootrows).to_csv(OUT/'bootstrap_RMSE_kondisional.csv',index=False)
corr=d.drop(columns='Sex').corr()['Rings'].drop('Rings').sort_values(ascending=False)
train_corr=d.iloc[tr].drop(columns='Sex').corr()['Rings'].drop('Rings').sort_values(ascending=False)
pd.DataFrame({'Variabel':corr.index,'r_semua_data':corr.values,'r_data_latih':train_corr.loc[corr.index].values}).to_csv(OUT/'korelasi.csv',index=False)
d.describe().T.to_csv(OUT/'deskriptif.csv')
json_data={'n':len(d),'n_train':ntrain,'n_test':len(te),'missing':int(d.isna().sum().sum()),'duplicate':int(d.duplicated().sum()),'height_flag':int(flag.sum()),'counts':{str(k):int(v) for k,v in d.Sex.value_counts().items()},'rings_mean':float(y.mean()),'rings_sd':float(y.std(ddof=1)),'rings_median':float(np.median(y)),'rings_min':int(y.min()),'rings_max':int(y.max()),'manual':manual,'r2_full':full.rsquared,'height_coef_all':full.params['Height'],'height_coef_sensitivity':sens.params['Height'],'max_vif':float(vif.VIF.max()),'rf_lm_rmse_diff':metric(y[te],pred['Random Forest'])['RMSE']-metric(y[te],pred['Regresi berganda'])['RMSE'],'rf_lm_rmse_diff_CI':np.quantile(diffs,[.025,.975]).tolist(),'results':res.to_dict('records'),'source_note':'Perhitungan pendamping Python. Split/fold sama dengan R; implementasi pohon dan random forest berbeda.'}
(OUT/'ringkasan.json').write_text(json.dumps(json_data,ensure_ascii=False,indent=2),encoding='utf-8')
# Export full sklearn trees to a portable offline dashboard.
def export_tree(est):
    t=est.tree_
    return {'l':t.children_left.tolist(),'r':t.children_right.tolist(),'f':t.feature.tolist(),'t':t.threshold.tolist(),'v':np.round(t.value[:,0,0],8).tolist()}
portable={'features':X.columns.tolist(),'coef_simple':models[0].params.to_list(),'coef_multi':models[1].params.to_list(),'mean':float(y[tr].mean()),'tree':export_tree(models[2]),'forest':[export_tree(t) for t in models[3].estimators_], 'results':res.to_dict('records'),'data':d.to_dict('records'),'split':split.to_dict('records'),'summary':json_data,'hc3':coef_table(hc3full,Z.columns).to_dict('records'),'vif':vif.to_dict('records'),'example':d.iloc[tr[0]].to_dict()}
(OUT/'model_dashboard_python.json').write_text(json.dumps(portable,separators=(',',':'),ensure_ascii=False),encoding='utf-8')
versions={'Python':sys.version,'platform':platform.platform(),'numpy':np.__version__,'pandas':pd.__version__,'scipy':scipy.__version__,'scikit-learn':sklearn.__version__,'statsmodels':sm.__version__,'csv_sha256':hashlib.sha256((ROOT/'data/abalone.csv').read_bytes()).hexdigest(),'R_execution':'NOT_EXECUTED: R runtime unavailable'}
(OUT/'versi_dan_status.json').write_text(json.dumps(versions,indent=2),encoding='utf-8')
print(res.to_string(index=False),flush=True)
print('Manual',manual,flush=True)
print('Paired CI',json_data['rf_lm_rmse_diff_CI'],flush=True)
print('Done',flush=True)
